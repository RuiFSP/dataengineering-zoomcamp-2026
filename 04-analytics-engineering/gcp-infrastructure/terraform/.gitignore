# Terraform state files
*.tfstate
*.tfstate.*
*.tfstate.backup

# Terraform variable files with sensitive data
dbt.tfvars
terraform.tfvars

# Service account keys (NEVER commit these)
keys/*.json
keys/*-key.json

# Terraform directories
.terraform/
.terraform.lock.hcl

# Crash log files
crash.log
crash.*.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration files
.terraformrc
terraform.rc
